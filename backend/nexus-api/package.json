{
  "name": "vigicore-nexus-server",
  "private": true,
  "version": "0.1.0",
  "description": "VigiCore NEXUS backend — Phase 1: foundation schema & authorization layer. Additive service, does not replace the existing /api/auth/* backend contract used by the frontend.",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node -r dotenv/config prisma/seed.ts",
    "seed:demo": "ts-node -r dotenv/config prisma/seed-demo.ts",
    "seed:services-demo": "ts-node -r dotenv/config prisma/seed-services-demo.ts",
    "purge:services-demo": "ts-node -r dotenv/config prisma/purge-services-demo.ts",
    "order:confirm": "ts-node -r dotenv/config src/scripts/confirmOrder.ts",
    "market:check": "tsx src/scripts/checkMarket.ts",
    "audit:ping": "tsx src/scripts/pingAudit.ts",
    "listing:link": "tsx src/scripts/linkListing.ts",
    "market:link": "tsx src/scripts/linkManufacturer.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.7",
    "otplib": "13.5.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "prisma": "^6.19.3",
    "smtp-server": "^3.20.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@6.19.3": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
