# ======================= DEVELOPMENT (SQLite) =======================
# prisma/schema.prisma = SQLite for local dev/tests. PRODUCTION uses PostgreSQL:
# prisma/postgres/schema.prisma + prisma/postgres/migrations (see docs/DEPLOYMENT.md).
# In production the server REFUSES to start with a file: URL.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DATABASE_URL="file:./dev.db"

# development | production. In production, src/lib/config.ts validates every variable below at startup
# and exits with a clear message (never printing values) if one is missing, a placeholder, or unsafe.
NODE_ENV=development

# Phase 2 (auth + services API) additions ------------------------------
# Secret used to sign the session cookie's JWT. Generate a real random
# value for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=""   # REQUIRED, >= 32 random chars (openssl rand -hex 32). Placeholders are rejected in production.

# Port the Express API listens on.
PORT=4000

# Must match the site's dev origin exactly (protocol + host + port) —
# credentials:'include' cookies are rejected by browsers on a mismatch.
CORS_ORIGIN="http://localhost:5176"   # production: exact https origin(s), comma-separated. With the bundled Caddy (same origin) CORS is not exercised.

# Phase 3 (paid placements on the /services page) -----------------------
# Where customers send the money. A method is offered in the dashboard ONLY
# when its account is set, so an unconfigured method can never be chosen.
# Fill in VigiCore's real details — these are shown to organizations.
PAYMENT_BENEFICIARY=""   # REQUIRED for a transfer method to be offered (no default is invented)
# CCP account (for BaridiMob / CCP), e.g. "0012345678 clé 42"
PAYMENT_CCP_ACCOUNT=""
# Bank RIB (for bank transfer)
PAYMENT_BANK_RIB=""
# After checking the money arrived, publish the product with:
#   npm run order:confirm -- <ORDER_REFERENCE>

# Phase 4 (staff payment review + invoices) -----------------------------
# VigiCore staff who may confirm/reject payments at /admin/payments.
# Comma-separated emails of EXISTING accounts. Empty = nobody (safe default).
PLATFORM_ADMIN_EMAILS=""   # real addresses of EXISTING accounts; demo/example addresses are refused in production
# The same staff get an e-mail when a product enters the "to validate" queue (needs SMTP). false = no e-mail.
LISTING_REVIEW_NOTIFY=true
# Seller block printed on every invoice (Algerian legal mentions).
INVOICE_SELLER_NAME=""   # NAME, ADDRESS, NIF, RC and NIS are ALL required: invoices answer 503 INVOICE_SELLER_INCOMPLETE until set
INVOICE_SELLER_ADDRESS=""
INVOICE_SELLER_NIF=""
INVOICE_SELLER_RC=""
INVOICE_SELLER_NIS=""
INVOICE_SELLER_CONTACT=""
# 0 = prices are shown without a VAT line. If prices already include TVA,
# set e.g. 19 and the invoice will split HT / TVA / TTC. Ask your accountant.
INVOICE_VAT_RATE=0

# Product Studio background removal (Bria RMBG 2.0) ----------------------
# Server-side ONLY. Never put this in the frontend / a VITE_* variable.
# Empty = cloud removal disabled; the app silently uses the local IMG.LY fallback.
BRIA_API_TOKEN=""
# Optional: max cloud cutouts per user per minute (default 10)
BRIA_MAX_PER_MINUTE=10

# Audio / video calls (Messenger) ----------------------------------------
# STUN alone works on one LAN. Between two different networks (Wi-Fi vs 4G, two sites) a TURN
# relay is usually needed for the media to flow. All optional — leave empty for LAN/dev.
# STUN_URLS="stun:stun.l.google.com:19302"
TURN_URLS=""
# Managed TURN provider (Metered, Twilio, Xirsys…): fixed credentials…
TURN_USERNAME=""
TURN_CREDENTIAL=""
# …or self-hosted coturn with use-auth-secret: just the shared secret (credentials are generated per request).
TURN_SECRET=""

# Phase 5 (Site -> Audit : déclarations, catalogue, messages) ------------
# URL du backend VigiCore Audit (explicite, jamais de port par défaut : voir
# docs/PORT_MAP.md côté Audit). Ex. http://localhost:5100
AUDIT_BASE_URL=http://localhost:5100
# Secret PARTAGÉ avec Audit (même variable NEXUS_SERVICE_JWT_SECRET des deux côtés),
# >= 32 caractères, ex. : openssl rand -hex 32. Sans lui, les déclarations sont
# enregistrées mais restent PENDING (jamais annoncées comme reçues).
NEXUS_SERVICE_JWT_SECRET=

# ======================= Added by the security/production pass =======================
# Number of reverse proxies in front of the API (bundled Caddy = 1). Unset = X-Forwarded-* NOT trusted.
# Needed for correct per-IP rate limiting and secure cookies behind a proxy. Do not set it without a proxy.
TRUST_PROXY=

# Public https base URL of the SITE (used to build password-reset links). Required for reset e-mails.
APP_BASE_URL=

# Outgoing e-mail (password reset + contact form). Any SMTP / transactional provider.
# Without SMTP_HOST + MAIL_FROM these features answer 503 instead of pretending to work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=            # "true" for implicit TLS (port 465); empty = STARTTLS when offered
SMTP_USER=
SMTP_PASS=
MAIL_FROM=              # e.g. "VigiCore NEXUS <no-reply@your-domain>"
CONTACT_TO=             # inbox that receives contact-form messages

# AI listing assistant (Anthropic). Server-side only.
ANTHROPIC_API_KEY=
# (see src/routes/ai.routes.ts for optional model/limit overrides)

# Persistent volume for chat files (default: server/storage next to the code — NOT persistent in containers).
STORAGE_DIR=

# Rate limits (requests per window, per IP). Defaults in src/lib/security.ts.
# RL_AUTH_MAX=20 (15 min)  RL_RESET_MAX=5 (1 h)  RL_CONTACT_MAX=5 (1 h)  RL_API_MAX=600 (1 min)

# Docker Compose (docker-compose.prod.yml) only:
# POSTGRES_DB= POSTGRES_USER= POSTGRES_PASSWORD= SITE_ADDRESS=your-domain.example

# --- Assistant VigiCore AI (réponses libres) ---------------------------------
# Avec ANTHROPIC_API_KEY (ci-dessus) l'assistant répond à toute formulation ; sans clé, il retombe sur des réponses à règles.
# ASSISTANT_LLM=off          coupe le modèle même si la clé existe
# ASSISTANT_MODEL=           modèle (défaut : ANTHROPIC_MODEL ou claude-haiku-4-5-20251001)
# ASSISTANT_TIMEOUT_MS=25000
# ASSISTANT_MAX_PER_MINUTE=30

# --- Pièces jointes des déclarations (conservation chiffrée) ------------------
# ATTACHMENT_ENC_KEY=   clé AES-256 : 64 caractères hexadécimaux (ex. `openssl rand -hex 32`) ou 32 octets en base64.
#                       Sans clé valide, la conservation est DÉSACTIVÉE (les pièces ne sont alors ni conservées ni simulées).
#                       Les fichiers chiffrés sont écrits dans <STORAGE_DIR>/attachments : sauvegardez le dossier ET la clé
#                       (sans la clé, les pièces sont illisibles). Ne jamais versionner la clé.

# Commandes aux fabricants depuis /services (sans paiement). Catégories d'acheteurs autorisées à COMMANDER
# (les autres envoient une demande d'intérêt). Même valeur que côté VigiCore Audit. À ajuster seulement
# après avis juridique. Valeurs : DISTRIBUTOR, PUBLIC_INSTITUTION, EXPORT, PRIVATE_PHARMACY, PRIVATE_CLINIC, PRIVATE_OTHER
MARKET_ORDER_BUYER_TYPES=
# Categories allowed to order from a DISTRIBUTOR (FOURNISSEUR) on /services. Default (empty) = all six: the buyer's company
# must still be VERIFIED by VigiCore staff. Example to open it to pharmacies and hospitals only:
#   SUPPLIER_ORDER_BUYER_TYPES=PRIVATE_PHARMACY,PUBLIC_INSTITUTION
SUPPLIER_ORDER_BUYER_TYPES=
# New-order / status e-mails to distributors and their buyers need SMTP_HOST + MAIL_FROM (above); the dashboard counter works without them.
# false = les comptes patients ne voient pas le catalogue des fabricants (publicité des médicaments au public).
MARKET_ALLOW_INDIVIDUALS=true

# Commandes : true = Audit SIMULÉ pour les offres/commandes (tests locaux). Lier un établissement à un fabricant « demo-… » (npm run seed:services-demo le fait pour Numidia). Laisser false en production.
MARKET_DEMO_OFFERS=false
# Seed de test : id de l'organisation fabricant (Numidia) dans le VRAI Audit. Vide = « demo-numidia » (mode démo).
DEMO_AUDIT_MANUFACTURER_REF=

# Alertes de retrait de lot (étape 3) : le Site RELIT le Logiciel (PAS instantané) pour les commandes CONFIRMED/DELIVERED.
# Cadre à confirmer avec l'encadrant / le MIPH. false = désactive le service (aucune relecture).
LOT_ALERTS_ENABLED=true
# Délai minimum entre deux relectures d'une même commande (minutes, ≥ 1). Défaut 15.
LOT_ALERTS_INTERVAL_MIN=15
# Nombre maximal de commandes relues par passe (1-100). Défaut 20.
LOT_ALERTS_BATCH=20
# Consigne ajoutée à l'alerte (≤ 300 car.). Défaut : « Ne distribuez plus ce lot et contactez le fabricant. » (à confirmer : encadrant/MIPH)


# Authentification à deux facteurs TOTP (opt-in par utilisateur). Désactivé par défaut : comportement identique à avant.
# true = active la fonction (migrations user_mfa appliquées ET MFA_ENCRYPTION_KEY valide requises).
MFA_ENABLED=false
# Clé de chiffrement des secrets TOTP : EXACTEMENT 32 octets en base64. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sans clé valide, le 2FA refuse de s'activer et les comptes qui l'ont déjà reçoivent 503 (jamais de contournement). Ne jamais committer la vraie valeur.
MFA_ENCRYPTION_KEY=
# Verrouillage temporaire du second facteur : nombre d'échecs (3-20, défaut 5) puis durée en minutes (1-1440, défaut 15).
MFA_MAX_FAILURES=5
MFA_LOCK_MINUTES=15
