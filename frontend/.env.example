# Build-time variables for the SPA (Vite). Nothing secret may ever be placed in a VITE_* variable.

# Public https URL of the site. When set at build time: canonical + og:url, sitemap.xml and a Sitemap line in robots.txt.
SITE_URL=

# Contact form: by default it posts to the API (/api/contact, delivered by e-mail server-side).
# Set this ONLY to use an external form provider instead.
# VITE_CONTACT_FORM_ENDPOINT=

# Operator identity shown on /legal, /privacy, /terms. Owner-supplied; missing values are displayed as "à renseigner".
VITE_LEGAL_PUBLISHER_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_DPO_CONTACT=
VITE_LEGAL_HOST=
VITE_LEGAL_LAST_UPDATED=
