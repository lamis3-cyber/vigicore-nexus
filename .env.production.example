# =====================================================================================================
# .env.production — TEMPLATE. Copy to `.env.production` (NEVER commit it), fill every value, then:
#   bash scripts/check-env-prod.sh            (checks that nothing required is missing)
#   docker compose -f docker-compose.prod.yml --env-file .env.production [--profile audit] up -d --build
# Generate secrets with:  openssl rand -hex 32
# Nothing here is invented: every value must come from you (domain, accounts, legal identity…).
# =====================================================================================================

# ---------- Domain / HTTPS (Caddy gets the certificate automatically; DNS A record must point to the server) ----------
SITE_ADDRESS=                 # e.g. vigicore.dz  (no https://)
SITE_URL=                     # e.g. https://vigicore.dz  (canonical, sitemap.xml, og:url)
CORS_ORIGIN=                  # e.g. https://vigicore.dz
APP_BASE_URL=                 # e.g. https://vigicore.dz  (password-reset links)

# ---------- Site database (PostgreSQL in compose) ----------
POSTGRES_DB=vigicore
POSTGRES_USER=vigicore
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ---------- Site API secrets (required) ----------
JWT_SECRET=                   # openssl rand -hex 32  (>= 32 chars, refused if placeholder)
PLATFORM_ADMIN_EMAILS=        # real e-mails of EXISTING accounts (comma-separated); @demo addresses are refused
ATTACHMENT_ENC_KEY=           # openssl rand -hex 32  — without it, declaration attachments are NOT stored. Back it up!

# ---------- E-mail (password reset, contact form, notifications) — otherwise these answer 503 ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                    # e.g. "VigiCore <no-reply@vigicore.dz>"
CONTACT_TO=

# ---------- Link Site -> VigiCore Audit (Logiciel) ----------
# With `--profile audit`: AUDIT_BASE_URL=http://audit-api:5100 (private compose network, accepted without https).
# Site only: leave BOTH empty (declarations are kept and sent later when Audit is connected).
AUDIT_BASE_URL=
NEXUS_SERVICE_JWT_SECRET=CHANGE_ME_NEXUS_SERVICE_JWT_SECRET

# ---------- Profile "audit" only ----------
AUDIT_POSTGRES_DB=materiovigilance
AUDIT_POSTGRES_USER=materio_user
AUDIT_POSTGRES_PASSWORD=CHANGE_ME_AUDIT_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
BOT_SERVICE_TOKEN=CHANGE_ME_BOT_SERVICE_TOKEN
AI_ANTHROPIC_API_KEY=CHANGE_ME_AI_ANTHROPIC_API_KEY
OLLAMA_URL=                   # e.g. http://ollama:11434 if you run Ollama (needs a lot of RAM)
OLLAMA_MODEL=llama3.2:3b

# ---------- Payments / invoices (optional: a method/invoice is offered only when configured) ----------
PAYMENT_BENEFICIARY=
PAYMENT_CCP_ACCOUNT=
PAYMENT_BANK_RIB=
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_NIF=
INVOICE_SELLER_RC=
INVOICE_SELLER_NIS=
INVOICE_SELLER_CONTACT=
INVOICE_VAT_RATE=0

# ---------- Optional services ----------
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
BRIA_API_TOKEN=CHANGE_ME_BRIA_API_TOKEN
TURN_URLS=                    # audio/video calls between different networks (see backend/nexus-api/.env.example)
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
MFA_ENABLED=false
MFA_ENCRYPTION_KEY=CHANGE_ME_MFA_ENCRYPTION_KEY

# ---------- Legal identity shown on /legal, /privacy, /terms (build-time; "à renseigner" if empty) ----------
VITE_LEGAL_PUBLISHER_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_DPO_CONTACT=
VITE_LEGAL_HOST=
VITE_LEGAL_LAST_UPDATED=
